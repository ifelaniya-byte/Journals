{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega-absolute.dev/spec/capability.schema.json",
  "title": "Capability Node",
  "description": "Every validated capability becomes a graph node with relationships and metadata (§19). Promotion requires the full gate sequence (§47).",
  "type": "object",
  "required": ["capability_id", "name", "version", "state", "development_state"],
  "properties": {
    "capability_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "state": { "$ref": "omega.schema.json#/definitions/CapabilityState" },
    "development_state": { "$ref": "omega.schema.json#/definitions/DevelopmentState" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "operations": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "object" },
    "performance": { "type": "object" },
    "cost": { "type": "object" },
    "reliability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "failure_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "transferability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "provenance": { "type": "array", "items": { "type": "string" } },
    "test_coverage": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "relationships": {
      "type": "object",
      "properties": {
        "REQUIRES": { "type": "array", "items": { "type": "string" } },
        "IMPROVES": { "type": "array", "items": { "type": "string" } },
        "CONFLICTS_WITH": { "type": "array", "items": { "type": "string" } },
        "SPECIALIZES": { "type": "array", "items": { "type": "string" } },
        "GENERALIZES": { "type": "array", "items": { "type": "string" } },
        "COMPOSES_WITH": { "type": "array", "items": { "type": "string" } },
        "DEPENDS_ON": { "type": "array", "items": { "type": "string" } },
        "TRANSFERS_TO": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
